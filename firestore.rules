rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /appointmentRequests/{requestId} {
      // Public visitors can create a narrowly-scoped appointment request only.
      allow create: if
        request.resource.data.keys().hasOnly([
          'name', 'phone', 'email', 'concern', 'appointmentDateTime',
          'status', 'source', 'createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'name', 'phone', 'email', 'concern', 'appointmentDateTime',
          'status', 'source', 'createdAt'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() >= 7 &&
        request.resource.data.phone.size() <= 30 &&
        (request.resource.data.email == null ||
          (request.resource.data.email is string &&
           request.resource.data.email.size() <= 254)) &&
        request.resource.data.concern is string &&
        request.resource.data.concern.size() >= 2 &&
        request.resource.data.concern.size() <= 100 &&
        request.resource.data.appointmentDateTime is string &&
        request.resource.data.appointmentDateTime.size() >= 10 &&
        request.resource.data.appointmentDateTime.size() <= 30 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.source == 'website' &&
        request.resource.data.createdAt == request.time;

      // Only staff with the admin custom claim may read or manage requests.
      allow read: if isAdmin();
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt', 'updatedBy']) &&
        request.resource.data.status in ['pending', 'contacted', 'confirmed', 'declined'];
      allow delete: if isAdmin();
    }
  }
}
